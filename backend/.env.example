# Django
DJANGO_SECRET_KEY=change-me-to-a-strong-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Database (Supabase/Postgres on Vercel)
# Set POSTGRES_DB (or run on Vercel) to enable PostgreSQL mode in settings.
POSTGRES_DB=postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=6543

# CORS / CSRF (comma-separated, exact origins of deployed frontend)
# Example: https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Optional integrations
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=