{
    "version": 2,
    "buildCommand": "chmod +x build_files.sh && ./build_files.sh",
    "builds": [
        {
            "src": "backend/core/wsgi.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "backend/staticfiles/$1"
        },
        {
            "src": "/(.*)",
            "dest": "backend/core/wsgi.py"
        }
    ]
}